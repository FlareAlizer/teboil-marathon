# Скопируйте этот файл в .env и подставьте свои значения.
# Сам .env в репозиторий не попадает.

# Пароль оператора для входа в админку (/admin).
# ОБЯЗАТЕЛЬНО смените: под этим паролем начисляют баллы и выдают призы.
ADMIN_PASSWORD=change-me

# Секрет для подписи cookie админ-сессии. Любая длинная случайная строка.
ADMIN_SESSION_SECRET=change-me-too

# Подключение к PostgreSQL.
# Локально можно поднять свой: node scripts/pg-dev.mjs
DATABASE_URL=postgres://teboil:пароль@localhost:5432/teboil

# Если база требует TLS (облачные провайдеры) — раскомментируйте:
# PGSSL=require

# Порт локального сервера на ноутбуке стенда
PORT=3000
